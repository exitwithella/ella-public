[
  {
    "id": 1,
    "question": "How is my client data handled?",
    "answer": {
      "root": {
        "children": [
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "Your client data is encrypted in transit and at rest. Our Sensemaking pipeline runs each engagement in a sandboxed workspace. ELLA never uses your data to train AI models, and you can export or delete your data at any time.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          },
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "We run on SOC 2 compliant infrastructure with granular role-based access control. Only the people you explicitly invite can access your workspace.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "type": "root",
        "version": 1
      }
    },
    "category": "security",
    "showOnPricing": true,
    "sortOrder": 1,
    "updatedAt": "2026-04-14T21:15:11.237Z",
    "createdAt": "2026-02-25T15:39:30.550Z"
  },
  {
    "id": 2,
    "question": "Can I use ELLA with my existing methodology?",
    "answer": {
      "root": {
        "children": [
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "ELLA is methodology-agnostic. It's designed to systematize your approach, not replace it. You customize the intake templates, discovery questions, and deliverable structures to match how you already work.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          },
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "Whether you follow the Value Acceleration Methodology, a proprietary framework, or something you've developed over decades, ELLA holds your process and makes it repeatable.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "type": "root",
        "version": 1
      }
    },
    "category": "platform",
    "showOnPricing": true,
    "sortOrder": 2,
    "updatedAt": "2026-04-14T21:04:22.148Z",
    "createdAt": "2026-02-25T15:39:30.563Z"
  },
  {
    "id": 3,
    "question": "How long does it take to get started?",
    "answer": {
      "root": {
        "type": "root",
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "textFormat": 0,
            "textStyle": "",
            "children": [
              {
                "type": "text",
                "version": 1,
                "text": "Most advisors are productive within their first client engagement. There's no lengthy onboarding or implementation project — you configure your templates, invite your first client, and start working.",
                "format": 0,
                "detail": 0,
                "mode": "normal",
                "style": ""
              }
            ]
          },
          {
            "type": "paragraph",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "textFormat": 0,
            "textStyle": "",
            "children": [
              {
                "type": "text",
                "version": 1,
                "text": "If you'd like a guided walkthrough, our team is happy to walk you through the platform and help you map your methodology into ELLA.",
                "format": 0,
                "detail": 0,
                "mode": "normal",
                "style": ""
              }
            ]
          }
        ]
      }
    },
    "category": "onboarding",
    "showOnPricing": true,
    "sortOrder": 3,
    "updatedAt": "2026-03-31T15:48:32.838Z",
    "createdAt": "2026-02-25T15:39:30.575Z"
  },
  {
    "id": 4,
    "question": "What's included in the Practitioner plan?",
    "answer": {
      "root": {
        "children": [
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "The Practitioner plan gives you full access to the ELLA platform: Fact Finding (structured discovery and client intake), Sensemaking (context-aware AI analysis sandboxed to each client), and Deliverables (client-ready documents built from your actual engagement data).",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          },
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "You get unlimited active client engagements, custom templates, a client portal, and basic support — everything you need to systematize a solo practice.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "type": "root",
        "version": 1
      }
    },
    "category": "pricing",
    "showOnPricing": true,
    "sortOrder": 4,
    "updatedAt": "2026-04-14T21:03:54.576Z",
    "createdAt": "2026-02-25T15:39:30.587Z"
  },
  {
