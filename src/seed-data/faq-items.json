  {
    "id": 8,
    "question": "Is ELLA only for exit planning?",
    "answer": {
      "root": {
        "children": [
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "Exit planning is our beachhead — it's where ELLA is deepest and most proven. But the platform is built for the full advisory lifecycle. Advisors use ELLA for wealth management, business advisory, tax and estate planning, and any engagement that involves guiding business owners through the most consequential decisions of their professional lives.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          },
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "We started with exit planning because that's where the workflow complexity is highest. Every other discipline benefits from the same systematized approach of structured discovery and client-ready deliverables.",
                "type": "text",
                "version": 1
              }
            ],
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "type": "paragraph",
            "version": 1,
            "textFormat": 0,
            "textStyle": ""
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "type": "root",
        "version": 1
      }
    },
    "category": "platform",
    "showOnPricing": true,
    "sortOrder": 8,
    "updatedAt": "2026-04-14T21:02:55.346Z",
    "createdAt": "2026-02-25T15:39:30.641Z"
  },
  {
