  {
    "id": 13,
    "question": "What is the Exit Team?",
    "answer": {
      "root": {
        "type": "root",
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "textFormat": 0,
            "textStyle": "",
            "children": [
              {
                "type": "text",
                "version": 1,
                "text": "The Exit Team is a group of advisors, collaborators, and other professionals (such as accountants, lawyers, financial advisors, and others) who are involved in the exit process.",
                "format": 0,
                "detail": 0,
                "mode": "normal",
                "style": ""
              }
            ]
          },
          {
            "type": "paragraph",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "textFormat": 0,
            "textStyle": "",
            "children": [
              {
                "type": "text",
                "version": 1,
                "text": "The exit team also includes the business owner(s) and people from their company or family who are involved in the exit process.",
                "format": 0,
                "detail": 0,
                "mode": "normal",
                "style": ""
              }
            ]
          }
        ]
      }
    },
    "category": "platform",
    "showOnPricing": true,
    "sortOrder": 13,
    "updatedAt": "2026-04-14T21:14:29.565Z",
    "createdAt": "2026-04-14T21:11:16.519Z"
  },
  {
    "id": 14,
    "question": "What Counts as an Active Client?",
    "answer": {
      "root": {
        "type": "root",
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "version": 1,
        "children": [
          {
            "type": "paragraph",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "textFormat": 0,
            "textStyle": "",
            "children": [
              {
                "type": "text",
                "version": 1,
                "text": "Each client can be enabled or disabled as needed. If you disable a client, you lose the following functionality:",
                "format": 0,
                "detail": 0,
                "mode": "normal",
                "style": ""
              }
            ]
          },
          {
            "type": "list",
            "listType": "bullet",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "start": 1,
            "tag": "ul",
            "children": [
              {
                "type": "listitem",
                "direction": "ltr",
                "format": "",
                "indent": 0,
                "version": 1,
                "value": 1,
                "children": [
                  {
                    "type": "text",
                    "version": 1,
                    "text": "You'll no longer be able to add or edit information about that client.",
                    "format": 0,
                    "detail": 0,
                    "mode": "normal",
                    "style": ""
                  }
                ]
              },
              {
                "type": "listitem",
                "direction": "ltr",
                "format": "",
                "indent": 0,
                "version": 1,
                "value": 2,
                "children": [
                  {
                    "type": "text",
                    "version": 1,
                    "text": "Sensemaking will no longer work, but existing chats will still be accessible.",
                    "format": 0,
                    "detail": 0,
                    "mode": "normal",
                    "style": ""
                  }
                ]
              },
              {
                "type": "listitem",
                "direction": "ltr",
                "format": "",
                "indent": 0,
                "version": 1,
                "value": 3,
                "children": [
                  {
                    "type": "text",
                    "version": 1,
                    "text": "The client portal will be disabled, so Collaborators and Small Business Owners will no longer be able to access any information about the client. Advisors in your organization will still be able to access them.",
                    "format": 0,
                    "detail": 0,
                    "mode": "normal",
                    "style": ""
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "direction": "ltr",
            "format": "",
            "indent": 0,
            "version": 1,
            "textFormat": 0,
            "textStyle": "",
            "children": [
              {
                "type": "text",
                "version": 1,
                "text": "Only active clients count towards billing limits. Inactive clients can be made active any time to regain full functionality.",
                "format": 0,
                "detail": 0,
                "mode": "normal",
                "style": ""
              }
            ]
          }
        ]
      }
    },
    "category": "pricing",
    "showOnPricing": true,
    "sortOrder": 14,
    "updatedAt": "2026-04-14T21:11:16.538Z",
    "createdAt": "2026-04-14T21:11:16.538Z"
