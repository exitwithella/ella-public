{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ella-public",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "5de67555-7b5a-4440-b654-feeb078b2b90",
      "database_name": "ella-public-payload",
      "remote": true,
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "5de67555-7b5a-4440-b654-feeb078b2b90",
      "database_name": "ella-public-payload",
      "remote": true,
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ella-public",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ella-public-payload",
      "preview_bucket_name": "ella-public-payload",
      // Allow `remoteBindings: true` (dev:remote / content sync) to read prod media.
      "remote": true,
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ella-public-isr-cache",
      "preview_bucket_name": "ella-public-isr-cache",
    },
  ],
  "vars": {
    "SITE_URL": "https://withella.io",
    "EMAIL_FROM_ADDRESS": "no-reply@hello.withella.io",
    "EMAIL_FROM_NAME": "ELLA",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },

  // Durable, manually-deployed staging environment (NOT wired into Workers
  // Builds — see docs/staging-environment.md). Deploy with:
  //   CLOUDFLARE_ENV=staging pnpm run deploy    (or: pnpm run deploy:staging)
  // Wrangler env bindings are NOT inherited, so the full binding set is
  // redeclared here, with the stateful ones pointed at staging resources.
  "env": {
    "staging": {
      "name": "ella-public-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "images": {
        "binding": "IMAGES",
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "00c59ec3-3b45-4a5a-a327-24a810f528b1",
          "database_name": "ella-public-staging-payload",
          "remote": true,
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_id": "00c59ec3-3b45-4a5a-a327-24a810f528b1",
          "database_name": "ella-public-staging-payload",
          "remote": true,
        },
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "ella-public-staging",
        },
      ],
      "r2_buckets": [
        {
          // Media reuses the PROD bucket (renders real images, zero copy).
          // Note: uploads via the staging admin write to prod R2. Switch to a
          // dedicated bucket if staging becomes a content-editing environment.
          "binding": "R2",
          "bucket_name": "ella-public-payload",
          "preview_bucket_name": "ella-public-payload",
          "remote": true,
        },
        {
          // ISR cache MUST be isolated from prod.
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "ella-public-staging-isr-cache",
          "preview_bucket_name": "ella-public-staging-isr-cache",
        },
      ],
      "vars": {
        // TODO: set to the real staging workers.dev URL after the first deploy.
        "SITE_URL": "https://ella-public-staging.workers.dev",
        "EMAIL_FROM_ADDRESS": "no-reply@hello.withella.io",
        "EMAIL_FROM_NAME": "ELLA (staging)",
      },
    },
  },
}
