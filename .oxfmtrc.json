{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "all",
  "experimentalSortImports": {},
  "experimentalTailwindcss": {},
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".cursor/**",
    "oatmeal-olive/**",
    "oatmeal-olive-familjen/**",
    "src/migrations/**",
    "src/payload-types.ts",
    "src/app/(payload)/admin/importMap.js",
    // Solution docs mix YAML frontmatter with identifiers like snake_case.
    // oxfmt rewrites their quotes and can turn those identifiers into broken emphasis.
    "docs/solutions/**/*.md"
  ]
}
