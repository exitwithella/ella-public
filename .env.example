# A generated secret for Payload
PAYLOAD_SECRET=

# Payload MCP API key (from Payload admin → payload-mcp-api-keys collection)
PAYLOAD_MCP_TOKEN=

# Public site URL — used by Payload for serverURL (admin/reset link host, etc.).
# Local dev: http://localhost:3000. Production: https://withella.io
SITE_URL=http://localhost:3000

# Resend — powers BOTH transactional email (password reset, etc.) and newsletter
# contact subscription (signup adds contacts/segments via the Resend API).
# Get from https://resend.com/api-keys. When unset, Payload's email-dependent
# flows and newsletter signup will fail.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@hello.withella.io
EMAIL_FROM_NAME=ELLA

# Remote bindings: when "true", local dev / dump / seed connect to the *remote*
# production D1 + R2 instead of local miniflare state. You normally do NOT set this
# in .env — the `dev:remote`, `content:pull`, and `content:push` scripts set it
# per-invocation. Requires Cloudflare auth: run `wrangler login` (or export
# CLOUDFLARE_API_TOKEN). See CLAUDE.md → "Local ↔ Production content sync".
# REMOTE_BINDINGS=true
