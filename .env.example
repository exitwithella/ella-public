# A generated secret for Payload
PAYLOAD_SECRET=

# Payload MCP API key (from Payload admin → payload-mcp-api-keys collection)
PAYLOAD_MCP_TOKEN=

# Public site URL — used by Payload for serverURL (admin/reset link host, etc.).
# Local dev: http://localhost:3000. Production: https://withella.io
SITE_URL=http://localhost:3000

# Resend transactional email (password reset, etc.). Get from https://resend.com/api-keys
# When unset, Payload's email-dependent flows (forgot/reset password) will fail.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@hello.withella.io
EMAIL_FROM_NAME=ELLA

# Loops contact subscription (newsletter signup). Get from https://app.loops.so/settings/api
LOOPS_API_KEY=
